---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import GuideCard from '../../components/GuideCard.astro';
import { getCollection } from 'astro:content';
import { breadcrumbSchema } from '../../lib/schema';

const guides = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order);
const crumbs = [{ name: 'Guides', href: '/guides/' }];
---

<Layout
  title="Hiriketiya Travel Guides: Weather, Surf, Food & Getting There"
  description="Everything you need to plan a trip to Hiriketiya, Sri Lanka: when to go, surf season, weather, restaurants, things to do and how to get there."
  schema={[breadcrumbSchema(crumbs)]}
>
  <PageHero
    crumbs={crumbs}
    eyebrow="Plan your trip"
    title="Hiriketiya <em>guides</em>"
    lead="Local, no fluff guides to planning your time in Hiriketiya and finding the right place to stay."
    image="/images/sunset.jpg"
    hue={180}
  />
  <div class="wrap">
    <div class="list">
      {guides.map((g) => <GuideCard id={g.id} title={g.data.title} description={g.data.description} order={g.data.order} />)}
    </div>
  </div>
</Layout>

<style>
  .list {
    display: grid;
    gap: 24px;
    margin-top: 32px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
  }
</style>
