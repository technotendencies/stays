---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import StayImage from '../../components/StayImage.astro';
import Icon from '../../components/Icon.astro';
import Wave from '../../components/Wave.astro';
import StayCard from '../../components/StayCard.astro';
import StayMap from '../../components/StayMap.astro';
import { stays } from '../../data/stays';
import { categoryCollection, getCollection as getStayCollection } from '../../data/collections';
import {
  amenityLabels,
  beachDistance,
  bookingHref,
  categoryLabels,
  formatDistance,
  priceSymbols,
  providerLabels,
  similarStays,
  typeLabels,
  walkMinutes,
} from '../../lib/stays';
import { abs, breadcrumbSchema } from '../../lib/schema';
import type { Stay } from '../../data/types';

export function getStaticPaths() {
  return stays.map((stay) => ({ params: { slug: stay.slug }, props: { stay } }));
}

const { stay } = Astro.props as { stay: Stay };
const d = beachDistance(stay);
const href = bookingHref(stay);
const provider = stay.booking ? providerLabels[stay.booking.provider] : undefined;
const primary = getStayCollection(categoryCollection[stay.categories[0]]);
const crumbs = [
  ...(primary ? [{ name: primary.label, href: `/${primary.slug}/` }] : [{ name: 'Stays', href: '/stays/' }]),
  { name: stay.name, href: `/stays/${stay.slug}/` },
];
const schema = [
  breadcrumbSchema(crumbs),
  {
    '@context': 'https://schema.org',
    '@type': stay.type === 'villa' || stay.type === 'apartment' ? 'VacationRental' : stay.type === 'hostel' ? 'Hostel' : 'Hotel',
    name: stay.name,
    description: stay.summary,
    url: abs(`/stays/${stay.slug}/`),
    address: { '@type': 'PostalAddress', addressLocality: stay.area === 'Dikwella' ? 'Dikwella' : 'Hiriketiya', addressRegion: 'Southern Province', addressCountry: 'LK' },
    geo: { '@type': 'GeoCoordinates', latitude: stay.coords[0], longitude: stay.coords[1] },
    priceRange: priceSymbols(stay.priceFrom),
    amenityFeature: stay.amenities.map((a) => ({ '@type': 'LocationFeatureSpecification', name: amenityLabels[a], value: true })),
  },
];
---

<Layout
  title={`${stay.name}, Hiriketiya | ${typeLabels[stay.type]} from $${stay.priceFrom}/night`}
  description={`${stay.summary} ${formatDistance(d.meters)}. ${stay.bestFor.join(', ')}.`}
  schema={stay.verified ? schema : [breadcrumbSchema(crumbs)]}
  noindex={!stay.verified}
>
  <section class="stay-hero dark">
    <div class="media"><StayImage stay={stay} eager /></div>
    <div class="shade" aria-hidden="true"></div>
    <div class="wrap inner">
      <Breadcrumbs items={crumbs} />
      <div class="title">
        <p class="eyebrow"><Icon name="mapPin" size={15} /> {typeLabels[stay.type]} · {stay.area}</p>
        <h1>{stay.name}</h1>
        <p class="sub">
          <span class="dist"><Icon name="footprints" size={16} /> {formatDistance(d.meters)}</span>
          {stay.rating && <span><Icon name="star" size={16} /> {stay.rating.toFixed(1)}</span>}
          <span><Icon name="users" size={16} /> Sleeps {stay.sleeps}</span>
          {stay.bedrooms && <span><Icon name="bed" size={16} /> {stay.bedrooms} bedroom{stay.bedrooms > 1 ? 's' : ''}</span>}
          {!stay.verified && <span class="badge demo">Demo listing</span>}
        </p>
      </div>
    </div>
    <div class="hero-wave"><Wave color="var(--sand-50)" /></div>
  </section>

  <div class="wrap">

    <div class="cols">
      <div class="main">
        <ul class="best">{stay.bestFor.map((b) => <li>{b}</li>)}</ul>
        <p class="summary">{stay.summary}</p>
        {stay.description.map((p) => <p>{p}</p>)}

        <h2>Highlights</h2>
        <ul class="highlights">{stay.highlights.map((h) => <li><Icon name="sparkles" size={18} /> {h}</li>)}</ul>

        <h2>Amenities</h2>
        <ul class="amenities">{stay.amenities.map((a) => <li><Icon name="check" size={16} /> {amenityLabels[a]}</li>)}</ul>

        <h2>Location</h2>
        <p>
          {stay.name} is in <b>{stay.area}</b>, about {d.meters}m from {d.beach}, roughly a {walkMinutes(d.meters)} minute walk.
        </p>
        <StayMap focus={stay.slug} height="340px" zoom={17} />

        <h2>Good for</h2>
        <p class="chips">
          {
            stay.categories.map((c) => (
              <a class="chip" href={`/${categoryCollection[c]}/`}>
                {categoryLabels[c]}
              </a>
            ))
          }
        </p>
      </div>

      <aside class="book">
        <div class="book-card">
          <p class="price">
            from <b>${stay.priceFrom}</b> / night
          </p>
          {stay.monthlyFrom && <p class="monthly">or ${stay.monthlyFrom.toLocaleString('en-US')} / month</p>}
          <p class="muted small">Typical low season rate. Prices change with dates.</p>
          {
            href ? (
              <a
                class="btn coral cta"
                href={href}
                target="_blank"
                rel={stay.booking?.affiliate ? 'sponsored nofollow noopener' : 'nofollow noopener'}
                data-booking={stay.booking?.provider}
              >
                Check availability →
              </a>
            ) : (
              <a class="btn coral cta" href="/list-your-property/">
                Ask about availability →
              </a>
            )
          }
          {provider && <p class="muted small via">via {provider}</p>}
          <ul class="checks small">
            <li><Icon name="check" size={16} /> {formatDistance(d.meters)}</li>
            {stay.amenities.includes('pool') && <li><Icon name="check" size={16} /> Pool</li>}
            {stay.amenities.includes('ac') && <li><Icon name="check" size={16} /> Air conditioning</li>}
            {stay.amenities.includes('breakfast') && <li><Icon name="check" size={16} /> Breakfast available</li>}
          </ul>
        </div>
      </aside>
    </div>

    <section class="similar">
      <h2>Similar stays in Hiriketiya</h2>
      <div class="grid">{similarStays(stay).map((s) => <StayCard stay={s} />)}</div>
    </section>
  </div>
</Layout>

<script>
  // Carry the dates from the search bar into the booking link.
  const a = document.querySelector<HTMLAnchorElement>('a[data-booking]');
  let search: { checkin?: string; checkout?: string; guests?: string } = {};
  try {
    search = JSON.parse(sessionStorage.getItem('hs-search') || '{}');
  } catch {}
  if (a && search.checkin && search.checkout) {
    const url = new URL(a.href);
    const p = a.dataset.booking;
    if (p === 'booking') {
      url.searchParams.set('checkin', search.checkin);
      url.searchParams.set('checkout', search.checkout);
      if (search.guests) url.searchParams.set('group_adults', search.guests);
    } else if (p === 'airbnb') {
      url.searchParams.set('checkin', search.checkin);
      url.searchParams.set('checkout', search.checkout);
      if (search.guests) url.searchParams.set('adults', search.guests);
    } else if (p === 'agoda') {
      url.searchParams.set('checkIn', search.checkin);
      const nights = Math.round((+new Date(search.checkout) - +new Date(search.checkin)) / 864e5);
      if (nights > 0) url.searchParams.set('los', String(nights));
      if (search.guests) url.searchParams.set('adults', search.guests);
    }
    a.href = url.toString();
  }
</script>

<style>
  .stay-hero {
    position: relative;
    min-height: min(78vh, 720px);
    display: flex;
    overflow: hidden;
  }
  .media,
  .shade {
    position: absolute;
    inset: 0;
  }
  .media :global(img),
  .media :global(svg) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .shade {
    background: linear-gradient(180deg, rgb(3 24 42 / 0.55) 0%, rgb(3 24 42 / 0) 30%, rgb(3 24 42 / 0.2) 55%, rgb(3 24 42 / 0.85) 100%);
  }
  .inner {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding-bottom: 110px;
  }
  .title h1 {
    color: #fff;
    margin: 0 0 14px;
    text-shadow: 0 2px 24px rgb(0 0 0 / 0.3);
  }
  .title .eyebrow {
    color: var(--lagoon-soft);
  }
  .sub {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    margin: 0;
  }
  .sub > span:not(.badge) {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 14px;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.14);
    border: 1px solid rgb(255 255 255 / 0.22);
    backdrop-filter: blur(8px);
    color: #fff;
    font-weight: 500;
    font-size: 0.95rem;
  }
  .sub :global(svg) {
    color: var(--lagoon-soft);
  }
  .hero-wave {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
  }
  .cols {
    display: grid;
    gap: 40px;
    margin-top: 32px;
  }
  @media (min-width: 900px) {
    .cols {
      grid-template-columns: 1fr 340px;
    }
  }
  .main {
    min-width: 0;
  }
  .main h2 {
    margin-top: 36px;
    font-size: 1.5rem;
  }
  .best {
    list-style: none;
    padding: 0;
    margin: 0 0 12px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .best li {
    background: var(--ocean-100);
    color: var(--ocean-900);
    font-weight: 600;
    font-size: 0.9rem;
    padding: 5px 12px;
    border-radius: 999px;
  }
  .summary {
    font-size: 1.2rem;
  }
  .highlights,
  .amenities {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .highlights li,
  .amenities li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    border-radius: 999px;
    background: var(--card);
    border: 1px solid var(--line);
  }
  .highlights li {
    background: var(--ocean-100);
    border-color: transparent;
    font-weight: 500;
  }
  .highlights :global(svg),
  .amenities :global(svg) {
    color: var(--ocean-500);
  }
  .book {
    position: relative;
  }
  .book-card {
    position: sticky;
    top: 84px;
    background: var(--card);
    padding: 24px;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }
  .price {
    margin: 0;
    color: var(--muted);
  }
  .price b {
    font-size: 1.8rem;
    color: var(--ink);
  }
  .monthly {
    margin: 0;
    font-weight: 600;
  }
  .small {
    font-size: 0.85rem;
  }
  .cta {
    width: 100%;
    margin-top: 12px;
    padding: 16px;
  }
  .via {
    text-align: center;
    margin: 8px 0 0;
  }
  .checks {
    list-style: none;
    padding: 0;
    margin: 16px 0 0;
    display: grid;
    gap: 6px;
  }
  .checks li {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .checks :global(svg) {
    color: var(--palm);
  }
  .similar {
    margin-top: 64px;
  }
</style>
