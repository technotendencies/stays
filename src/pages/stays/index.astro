---
import Layout from '../../layouts/Layout.astro';
import SearchBar from '../../components/SearchBar.astro';
import StayCard from '../../components/StayCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { allStays, categoryLabels } from '../../lib/stays';
import { months } from '../../data/seasons';
import { breadcrumbSchema } from '../../lib/schema';
import type { Category } from '../../data/types';

const stays = allStays();
const cats: Category[] = ['beachfront', 'villas', 'boutique', 'budget', 'surf', 'long-stays', 'luxury'];
const crumbs = [{ name: 'Stays', href: '/stays/' }];
---

<Layout
  title="All Stays in Hiriketiya: Villas, Hotels & Guesthouses"
  description="Every place to stay in Hiriketiya, Sri Lanka, in one list: filter by villas, beachfront, surf, budget or long stays and compare prices."
  schema={[breadcrumbSchema(crumbs)]}
>
  <div class="wrap">
    <Breadcrumbs items={crumbs} />
    <h1>Stays in Hiriketiya</h1>
    <SearchBar compact />
    <p class="season" data-season hidden></p>
    <div class="chips filters" role="group" aria-label="Filter stays">
      <button type="button" class="chip" data-cat="" aria-pressed="true">All</button>
      {cats.map((c) => <button type="button" class="chip" data-cat={c} aria-pressed="false">{categoryLabels[c]}</button>)}
    </div>
    <p class="muted count" data-count aria-live="polite">{stays.length} stays</p>
    <div class="grid" data-results>
      {stays.map((s) => <StayCard stay={s} />)}
    </div>
    <p class="empty" data-empty hidden>
      Nothing matches that yet. <a href="/stays/">Clear filters</a> or <a href="/map/">browse the map</a>.
    </p>
  </div>
</Layout>

<script is:inline define:vars={{ months }}>
  const params = new URLSearchParams(location.search);
  const guests = Number(params.get('guests') || 0);
  let cat = params.get('category') || '';
  const cards = [...document.querySelectorAll('[data-results] > article')];
  const chips = [...document.querySelectorAll('[data-cat]')];

  // Show what the season looks like for the chosen arrival month.
  const checkin = params.get('checkin');
  if (checkin) {
    const m = months[new Date(checkin).getMonth()];
    const el = document.querySelector('[data-season]');
    if (m && el) {
      el.innerHTML = `<b>${m.name} in Hiriketiya:</b> ${m.weather.toLowerCase()}, surf ${m.surf.toLowerCase()}, ${m.crowds.toLowerCase()} crowds. ${m.note} <a href="/guides/best-time-to-visit-hiriketiya/#${m.slug}">More →</a>`;
      el.hidden = false;
    }
  }

  function apply() {
    let shown = 0;
    for (const card of cards) {
      const okGuests = !guests || Number(card.dataset.sleeps) >= guests;
      const okCat = !cat || card.dataset.categories.split(' ').includes(cat);
      card.hidden = !(okGuests && okCat);
      if (!card.hidden) shown++;
    }
    chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.cat === cat)));
    document.querySelector('[data-count]').textContent = `${shown} ${shown === 1 ? 'stay' : 'stays'}${guests ? ` for ${guests} ${guests === 1 ? 'guest' : 'guests'}` : ''}`;
    document.querySelector('[data-empty]').hidden = shown > 0;
  }

  chips.forEach((c) =>
    c.addEventListener('click', () => {
      cat = c.dataset.cat;
      const url = new URL(location.href);
      cat ? url.searchParams.set('category', cat) : url.searchParams.delete('category');
      history.replaceState(null, '', url);
      apply();
    }),
  );
  apply();
</script>

<style>
  h1 {
    margin: 8px 0 20px;
  }
  .season {
    background: var(--ocean-100);
    padding: 12px 16px;
    border-radius: 12px;
    margin: 20px 0 0;
    max-width: 760px;
  }
  .filters {
    margin: 24px 0 8px;
  }
  .count {
    margin: 0 0 16px;
  }
  .empty {
    padding: 40px 0;
  }
</style>
