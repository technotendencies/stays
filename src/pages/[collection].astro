---
import StayCollectionPage from '../components/pages/StayCollectionPage.astro';
import TopicPage from '../components/pages/TopicPage.astro';
import { collections, type Collection } from '../data/collections';
import { topics, type Topic } from '../data/topics';

/** Root level SEO pages: stay collections (/hiriketiya-villas/) and local topics (/hiriketiya-nightlife/). */
export function getStaticPaths() {
  return [
    ...collections.map((c) => ({ params: { collection: c.slug }, props: { c, t: undefined } })),
    ...topics.map((t) => ({ params: { collection: t.slug }, props: { c: undefined, t } })),
  ];
}

const { c, t } = Astro.props as { c?: Collection; t?: Topic };
---

{c && <StayCollectionPage c={c} />}
{t && <TopicPage t={t} />}
