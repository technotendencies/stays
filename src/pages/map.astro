---
import Layout from '../layouts/Layout.astro';
import StayMap from '../components/StayMap.astro';
import { breadcrumbSchema } from '../lib/schema';
import PageHero from '../components/PageHero.astro';

const crumbs = [{ name: 'Stay map', href: '/map/' }];
---

<Layout
  title="Hiriketiya Map: Every Stay, Beach, Surf Break & Café"
  description="Interactive map of Hiriketiya, Sri Lanka: every hotel, villa and guesthouse with price and distance to the beach, plus surf spots and restaurants."
  schema={[breadcrumbSchema(crumbs)]}
>
  <PageHero
    crumbs={crumbs}
    eyebrow="Interactive map"
    title="The Hiriketiya <em>Stay Map</em>"
    lead="Tap a price to see the stay. Toggle beaches, surf breaks and restaurants, or narrow down to villas, hotels, budget or luxury."
    hue={200}
  />
  <div class="wrap map-wrap">
    <StayMap filters list height="min(72vh, 680px)" />
  </div>
</Layout>

<style>
  .map-wrap {
    padding-top: 28px;
  }
</style>
