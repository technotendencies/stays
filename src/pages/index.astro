---
import Layout from '../layouts/Layout.astro';
import SearchBar from '../components/SearchBar.astro';
import CategoryChips from '../components/CategoryChips.astro';
import StayCard from '../components/StayCard.astro';
import StayMap from '../components/StayMap.astro';
import OceanArt from '../components/OceanArt.astro';
import Wave from '../components/Wave.astro';
import GuideCard from '../components/GuideCard.astro';
import Icon from '../components/Icon.astro';
import { featuredStays } from '../lib/stays';
import { site } from '../data/site';
import { collections } from '../data/collections';
import { photo, photoCredit, sitePhotos } from '../lib/photos';
import { getCollection } from 'astro:content';
import type { IconName } from '../lib/icons';

const popular = featuredStays(6);
const guides = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order).slice(0, 6);
const hero = photo(sitePhotos.hero);
const areas = [
  {
    name: 'The bay',
    text: 'Surf, cafés and sunsets on your doorstep. Best for surfers and first visits.',
    href: '/hiriketiya-beachfront-hotels/',
    img: photo(sitePhotos.areas.bay),
    hue: 185,
    time: 'day' as const,
  },
  {
    name: 'The hill',
    text: 'Quiet coconut groves and pool villas, five to fifteen minutes on foot from the sand.',
    href: '/hiriketiya-villas/',
    img: photo(sitePhotos.areas.hill),
    hue: 165,
    time: 'day' as const,
  },
  {
    name: 'Dikwella',
    text: 'The long, calm beach next door with bigger beachfront villas and hotels.',
    href: '/where-to-stay-in-hiriketiya/',
    img: photo(sitePhotos.areas.dikwella),
    hue: 200,
    time: 'dusk' as const,
  },
];
const facts: { icon: IconName; big: string; small: string }[] = [
  { icon: 'waves', big: 'One bay', small: 'A small horseshoe bay you can walk around in ten minutes' },
  { icon: 'sun', big: 'Dec to Mar', small: 'Dry season with the most consistent surf' },
  { icon: 'thermometer', big: '27 to 29°C', small: 'Warm sea all year. No wetsuit needed' },
  { icon: 'plane', big: 'About 3h', small: 'By car from Colombo and the airport' },
];
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: site.name,
    url: site.url,
  },
];
---

<Layout
  title="Hiriketiya Stays | Find Your Perfect Stay in Hiriketiya, Sri Lanka"
  description="The easiest way to find where to stay in Hiriketiya. Compare villas, beachfront hotels, surf stays and budget guesthouses on one map."
  schema={schema}
  overlay
>
  <section class="hero">
    <div class="hero-media" aria-hidden="true">
      {hero ? <img src={hero} alt={photoCredit(hero)?.alt ?? "Couple sitting on a rock above the waves at sunset, framed by tropical leaves"} fetchpriority="high" /> : <OceanArt hue={188} time="dusk" />}
    </div>
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="wrap hero-inner">
      <div class="hero-content">
      <p class="eyebrow"><Icon name="mapPin" size={15} /> Hiriketiya · Sri Lanka</p>
      <h1>Find your <em>perfect</em> stay in Hiriketiya</h1>
      <p class="lead">Every villa, surf house and boutique hotel around Hiriketiya. Welcome to paradise on earth.</p>
      <SearchBar />
      <CategoryChips glass />
      </div>
    </div>
    <div class="hero-wave"><Wave color="var(--deep)" /></div>
  </section>

  <section class="section dark popular">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Handpicked</p>
          <h2>Popular stays in <em>Hiriketiya</em></h2>
        </div>
        <a class="link-arrow" href="/stays/">See all stays <Icon name="arrowRight" size={16} /></a>
      </div>
      <div class="grid">
        {popular.map((s, i) => <StayCard stay={s} rank={i + 1} />)}
      </div>
    </div>
  </section>
  <Wave color="var(--sand-50)" bg="var(--deep)" />

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Where to stay</p>
          <h2>Three ways to wake up by the sea</h2>
        </div>
        <a class="link-arrow" href="/where-to-stay-in-hiriketiya/">Compare the areas <Icon name="arrowRight" size={16} /></a>
      </div>
      <div class="areas">
        {
          areas.map((a) => (
            <a class="area" href={a.href}>
              <div class="area-media">{a.img ? <img src={a.img} alt={photoCredit(a.img)?.alt ?? ""} loading="lazy" /> : <OceanArt hue={a.hue} time={a.time} />}</div>
              <div class="area-text">
                <h3>{a.name}</h3>
                <p>{a.text}</p>
                <span class="link-arrow">
                  Explore <Icon name="arrowRight" size={16} />
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section map-teaser">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow"><Icon name="map" size={15} /> The Hiriketiya Stay Map</p>
          <h2>See exactly where you'll wake up</h2>
          <p class="lead">Every stay, beach, surf break and café in one place. Filter by villas, hotels, budget or luxury.</p>
        </div>
        <a class="btn" href="/map/">Open the full map <Icon name="arrowRight" size={16} /></a>
      </div>
      <StayMap height="440px" filters />
    </div>
  </section>

  <Wave color="var(--ocean-800)" bg="var(--foam)" />
  <section class="section dark glance">
    <div class="wrap">
      <p class="eyebrow">The bay at a glance</p>
      <h2>Small bay, big reasons to stay</h2>
      <div class="facts">
        {
          facts.map((f) => (
            <div class="fact">
              <Icon name={f.icon} size={26} />
              <b>{f.big}</b>
              <span>{f.small}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>
  <Wave color="var(--sand-50)" bg="var(--deep)" />

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Plan your trip</p>
          <h2>Hiriketiya guides</h2>
        </div>
        <a class="link-arrow" href="/guides/">All guides <Icon name="arrowRight" size={16} /></a>
      </div>
      <div class="guides">
        {guides.map((g) => <GuideCard id={g.id} title={g.data.title} description={g.data.description} order={g.data.order} />)}
      </div>
    </div>
  </section>

  <section class="section types">
    <div class="wrap">
      <h2>Browse stays by type</h2>
      <ul class="collections">
        {
          collections.map((c) => (
            <li>
              <a href={`/${c.slug}/`}>
                {c.h1} <Icon name="arrowRight" size={16} />
              </a>
            </li>
          ))
        }
      </ul>
      <div class="host dark">
        <div>
          <h3>Own a place in Hiriketiya?</h3>
          <p class="muted">Get listed on the stay map with a direct booking link. No commission on direct deals.</p>
        </div>
        <a class="btn lagoon" href="/list-your-property/">List your property <Icon name="arrowRight" size={16} /></a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero {
    position: relative;
    min-height: min(100svh, 920px);
    display: flex;
    align-items: center;
    overflow: hidden;
    background: var(--deep);
    color: #fff;
  }
  .hero-media,
  .hero-shade {
    position: absolute;
    inset: 0;
  }
  .hero-media :global(img),
  .hero-media :global(svg) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Keep the couple on the rock in view. */
    object-position: 50% 52%;
    animation: drift 24s ease-in-out infinite alternate;
  }
  /* Taller crops on wide screens: keep the couple clear of the wave edge. */
  @media (min-width: 1400px) {
    .hero-media :global(img) {
      object-position: 50% 57%;
    }
  }
  @keyframes drift {
    from {
      transform: scale(1.02);
    }
    to {
      transform: scale(1.1) translateX(-1.5%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-media :global(img),
    .hero-media :global(svg) {
      animation: none;
    }
  }
  .hero-shade {
    background:
      linear-gradient(180deg, rgb(3 24 42 / 0.45) 0%, rgb(3 24 42 / 0) 30%, rgb(3 24 42 / 0.1) 70%, rgb(3 24 42 / 0.8) 100%),
      linear-gradient(90deg, rgb(3 24 42 / 0.6) 0%, rgb(3 24 42 / 0.2) 45%, rgb(3 24 42 / 0) 65%);
  }
  .hero-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding-top: 130px;
    padding-bottom: 150px;
  }
  .hero-content {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  @media (min-width: 1000px) {
    .hero-content {
      max-width: 640px;
    }
  }
  /* Phones: text at the top, the photo made taller than the hero so the couple
     on the rock lands in the open space below the search. */
  @media (max-width: 720px) {
    .hero {
      align-items: flex-start;
      /* Small phones scroll a little rather than hide the couple behind the search. */
      min-height: max(min(100svh, 920px), 780px);
    }
    .hero-media :global(img) {
      height: 125%;
      object-position: 60% 0;
    }
    .hero-shade {
      background: linear-gradient(180deg, rgb(3 24 42 / 0.6) 0%, rgb(3 24 42 / 0.35) 55%, rgb(3 24 42 / 0) 72%, rgb(3 24 42 / 0.5) 100%);
    }
    .hero-inner {
      gap: 16px;
      padding-top: 96px;
    }
    .hero .lead {
      font-size: 1.1rem;
    }
    .hero :global(.chips) {
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
      margin-right: -16px;
      padding-right: 16px;
    }
    .hero :global(.chip) {
      flex: none;
    }
  }
  .hero .eyebrow {
    color: var(--lagoon-soft);
  }
  .hero h1 {
    max-width: 13ch;
    margin: 0;
    text-shadow: 0 2px 30px rgb(0 0 0 / 0.25);
  }
  .hero h1 em {
    color: var(--lagoon-soft);
  }
  .hero .lead {
    color: rgb(255 255 255 / 0.88);
    margin: 0;
    font-size: 1.25rem;
  }
  .hero-wave {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
  }
  .popular {
    padding-top: 40px;
    background: linear-gradient(180deg, var(--deep) 0%, var(--ocean-900) 45%, var(--deep) 100%);
  }
  .areas {
    display: grid;
    gap: 24px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
  }
  .area {
    position: relative;
    display: block;
    min-height: 420px;
    border-radius: var(--radius);
    overflow: hidden;
    color: #fff;
    text-decoration: none;
    box-shadow: var(--shadow);
  }
  .area-media {
    position: absolute;
    inset: 0;
  }
  .area-media :global(img),
  .area-media :global(svg) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  .area:hover .area-media :global(img),
  .area:hover .area-media :global(svg) {
    transform: scale(1.05);
  }
  .area-text {
    position: absolute;
    inset: auto 0 0 0;
    padding: 80px 26px 26px;
    background: linear-gradient(180deg, rgb(3 24 42 / 0) 0%, rgb(3 24 42 / 0.85) 60%);
  }
  .area h3 {
    font-size: 2rem;
    margin: 0 0 6px;
  }
  .area p {
    margin: 0 0 12px;
    color: rgb(255 255 255 / 0.85);
  }
  .area .link-arrow {
    color: var(--lagoon-soft);
  }
  .map-teaser {
    background: var(--foam);
  }
  .glance {
    padding-top: 40px;
    background: linear-gradient(180deg, var(--ocean-800) 0%, var(--ocean-900) 50%, var(--deep) 100%);
  }
  .facts {
    display: grid;
    gap: 20px;
    margin-top: 36px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
  }
  .fact {
    display: grid;
    align-content: start;
    gap: 6px;
    padding: 26px;
    border-radius: var(--radius);
    background: rgb(255 255 255 / 0.05);
    border: 1px solid rgb(69 201 198 / 0.2);
  }
  .fact :global(svg) {
    color: var(--lagoon);
    margin-bottom: 8px;
  }
  .fact b {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 2rem;
    line-height: 1.1;
  }
  .fact span {
    color: var(--on-dark-muted);
  }
  .guides {
    display: grid;
    gap: 24px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
  }
  .types {
    padding-top: 24px;
  }
  .collections {
    list-style: none;
    padding: 0;
    margin: 24px 0 48px;
    display: grid;
    gap: 0 32px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
  }
  .collections a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
    font-weight: 500;
  }
  .collections a:hover {
    color: var(--ocean-500);
  }
  .host {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 32px;
    border-radius: var(--radius);
    border: 1px solid rgb(69 201 198 / 0.25);
  }
  .host h3 {
    font-size: 1.7rem;
    margin: 0 0 4px;
  }
  .host p {
    margin: 0;
  }
</style>
