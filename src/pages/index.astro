---
import Layout from '../layouts/Layout.astro';
import SearchBar from '../components/SearchBar.astro';
import CategoryChips from '../components/CategoryChips.astro';
import StayCard from '../components/StayCard.astro';
import StayMap from '../components/StayMap.astro';
import { featuredStays } from '../lib/stays';
import { site } from '../data/site';
import { collections } from '../data/collections';
import { getCollection } from 'astro:content';

const popular = featuredStays(6);
const guides = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order).slice(0, 6);
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: site.name,
    url: site.url,
    potentialAction: {
      '@type': 'SearchAction',
      target: `${site.url}/stays/?guests={guests}`,
      'query-input': 'required name=guests',
    },
  },
];
---

<Layout
  title="Hiriketiya Stays | Find Your Perfect Stay in Hiriketiya, Sri Lanka"
  description="The easiest way to find where to stay in Hiriketiya. Compare villas, beachfront hotels, surf stays and budget guesthouses on one map."
  schema={schema}
>
  <section class="hero">
    <div class="hero-bg" aria-hidden="true">
      <svg viewBox="0 0 1440 720" preserveAspectRatio="xMidYMid slice">
        <defs>
          <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#fbd9b8"></stop>
            <stop offset="0.55" stop-color="#bfe3e2"></stop>
            <stop offset="1" stop-color="#7cc4c8"></stop>
          </linearGradient>
        </defs>
        <rect width="1440" height="720" fill="url(#sky)"></rect>
        <circle cx="1080" cy="210" r="90" fill="#f08a5d" opacity="0.85"></circle>
        <path d="M0 430 C 300 380, 520 520, 720 520 S 1140 380, 1440 430 V720 H0Z" fill="#148a99"></path>
        <path class="wave" d="M0 500 C 240 470, 480 560, 720 560 S 1200 470, 1440 500 V720 H0Z" fill="#0f5f6f" opacity="0.7"></path>
        <path d="M0 610 C 320 560, 560 640, 720 640 S 1120 560, 1440 610 V720 H0Z" fill="#efe3cb"></path>
        <g fill="#1f5b3c" opacity="0.85">
          <g transform="translate(-150 60)">
            <rect x="190" y="250" width="10" height="220" rx="5" transform="rotate(-8 195 470)"></rect>
            <path d="M196 252c-40-24-80-16-104 8 32-8 68-4 104-8zm0 0c32-36 76-40 112-20-36 0-76 8-112 20zm0 0c-8-40 12-72 40-88-16 28-28 56-40 88zm0 0c-28-28-64-36-92-24 32 4 64 12 92 24z"></path>
          </g>
          <rect x="1250" y="270" width="9" height="200" rx="4.5" transform="rotate(7 1254 470)"></rect>
          <path d="M1256 272c-34-20-68-12-88 8 28-6 58-4 88-8zm0 0c28-30 66-34 96-16-30 0-66 6-96 16zm0 0c-6-34 10-60 34-74-14 24-24 48-34 74z"></path>
        </g>
      </svg>
    </div>
    <div class="wrap hero-inner">
      <p class="eyebrow">Hiriketiya · Sri Lanka</p>
      <h1>Find your <em>perfect</em> stay in Hiriketiya</h1>
      <p class="lead">Every villa, surf house and boutique hotel around the bay on one map, with honest distances to the beach.</p>
      <CategoryChips />
      <SearchBar />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Handpicked</p>
          <h2>Popular stays in Hiriketiya</h2>
        </div>
        <a class="link-arrow" href="/stays/">See all stays →</a>
      </div>
      <div class="grid">
        {popular.map((s) => <StayCard stay={s} />)}
      </div>
    </div>
  </section>

  <section class="section map-teaser">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">The Hiriketiya Stay Map</p>
          <h2>See exactly where you'll wake up</h2>
          <p class="lead">Every stay, beach, surf break and café in one place. Filter by villas, hotels, budget or luxury.</p>
        </div>
        <a class="btn" href="/map/">Open the full map →</a>
      </div>
      <StayMap height="420px" filters />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Plan your trip</p>
          <h2>Hiriketiya guides</h2>
        </div>
        <a class="link-arrow" href="/guides/">All guides →</a>
      </div>
      <div class="guides">
        {
          guides.map((g) => (
            <a class="guide" href={`/guides/${g.id}/`}>
              <span class="g-emoji" aria-hidden="true">
                {g.data.emoji}
              </span>
              <span class="g-title">{g.data.title}</span>
              <span class="g-desc">{g.data.description}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Browse stays by type</h2>
      <ul class="collections">
        {
          collections.map((c) => (
            <li>
              <a href={`/${c.slug}/`}>{c.h1} →</a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Layout>

<style>
  .hero {
    position: relative;
    min-height: min(88vh, 760px);
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
  }
  .hero-bg svg {
    width: 100%;
    height: 100%;
  }
  .wave {
    animation: drift 9s ease-in-out infinite alternate;
  }
  @keyframes drift {
    to {
      transform: translateX(-30px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .wave {
      animation: none;
    }
  }
  .hero-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding-top: 48px;
    padding-bottom: 120px;
  }
  .hero h1 {
    color: var(--ocean-900);
    max-width: 14ch;
    margin: 0;
  }
  .hero .lead {
    color: #24454c;
    margin: 0;
  }
  .map-teaser {
    background: var(--sand-100);
  }
  .guides {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
  }
  .guide {
    display: grid;
    gap: 4px;
    padding: 20px;
    background: var(--card);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    text-decoration: none;
    color: var(--ink);
  }
  .guide:hover .g-title {
    color: var(--ocean-700);
  }
  .g-emoji {
    font-size: 1.6rem;
  }
  .g-title {
    font-family: var(--font-display);
    font-size: 1.2rem;
  }
  .g-desc {
    color: var(--muted);
    font-size: 0.92rem;
  }
  .collections {
    list-style: none;
    padding: 0;
    columns: 2 260px;
    gap: 24px;
  }
  .collections li {
    padding: 6px 0;
    break-inside: avoid;
  }
</style>
