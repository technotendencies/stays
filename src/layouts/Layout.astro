---
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '@fontsource-variable/figtree/wght.css';
import '../styles/global.css';
import { site } from '../data/site';
import Wave from '../components/Wave.astro';
import LogoMark from '../components/LogoMark.astro';

interface Props {
  title: string;
  description: string;
  /** Extra JSON-LD objects for this page. */
  schema?: object[];
  image?: string;
  noindex?: boolean;
  /** Header floats over a full bleed hero and turns solid on scroll. */
  overlay?: boolean;
}

const { title, description, schema = [], image = '/og-default.svg', noindex = false, overlay = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).toString();
const ogImage = new URL(image, site.url).toString();
const nav = [
  { href: '/stays/', label: 'Stays' },
  { href: '/map/', label: 'Map' },
  { href: '/where-to-stay-in-hiriketiya/', label: 'Where to stay' },
  { href: '/guides/', label: 'Guides' },
];
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <header class:list={['site-header', { overlay }]} data-header>
      <div class="wrap bar">
        <a href="/" class="logo" aria-label={`${site.name} home`}>
          <LogoMark />
          <span><i>Hiriketiya</i> Stays</span>
        </a>
        <nav aria-label="Main">
          {nav.map((n) => <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>)}
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <Wave color="var(--deep)" />
    <footer class="site-footer">
      <div class="wrap cols">
        <div>
          <p class="logo-foot"><LogoMark size={40} /> <span><i>Hiriketiya</i> Stays</span></p>
          <p class="muted">{site.tagline}</p>
          <p><a href="/list-your-property/">List your property →</a></p>
          <p><a href="/photo-credits/">Photo sources</a></p>
        </div>
        <div>
          <h4>Stays</h4>
          <a href="/hiriketiya-villas/">Villas</a>
          <a href="/hiriketiya-beachfront-hotels/">Beachfront</a>
          <a href="/hiriketiya-surf-accommodation/">Surf stays</a>
          <a href="/cheap-accommodation-hiriketiya/">Budget</a>
          <a href="/luxury-hotels-hiriketiya/">Luxury</a>
          <a href="/hiriketiya-long-term-rental/">Long term rentals</a>
        </div>
        <div>
          <h4>Guides</h4>
          <a href="/guides/best-time-to-visit-hiriketiya/">Best time to visit</a>
          <a href="/guides/hiriketiya-surf-season/">Surf season</a>
          <a href="/guides/hiriketiya-weather/">Weather</a>
          <a href="/guides/how-to-get-to-hiriketiya/">How to get there</a>
          <a href="/guides/hiriketiya-vs-mirissa/">Hiriketiya vs Mirissa</a>
          <a href="/guides/hiriketiya-vs-weligama/">Hiriketiya vs Weligama</a>
        </div>
      </div>
      <div class="wrap fine muted">
        © {new Date().getFullYear()} {site.name}
      </div>
    </footer>
    <script>
      const header = document.querySelector<HTMLElement>('[data-header].overlay');
      if (header) {
        const update = () => header.classList.toggle('solid', window.scrollY > 40);
        update();
        window.addEventListener('scroll', update, { passive: true });
      }
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: rgb(3 24 42 / 0.92);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
    transition:
      background 0.25s,
      border-color 0.25s;
  }
  .site-header.overlay {
    position: fixed;
    left: 0;
    right: 0;
    background: transparent;
    border-color: transparent;
    backdrop-filter: none;
  }
  .site-header.overlay.solid {
    background: rgb(3 24 42 / 0.92);
    backdrop-filter: blur(12px);
    border-color: rgb(255 255 255 / 0.08);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 68px;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: #fff;
    font-family: var(--font-display);
    font-size: 1.35rem;
    letter-spacing: -0.01em;
  }
  .logo i,
  .logo-foot i {
    color: var(--lagoon-soft);
  }
  nav {
    display: flex;
    gap: 2px;
    overflow-x: auto;
    scrollbar-width: none;
  }
  nav a {
    padding: 8px 14px;
    border-radius: 999px;
    text-decoration: none;
    color: rgb(255 255 255 / 0.85);
    font-weight: 500;
    font-size: 0.97rem;
    white-space: nowrap;
    transition: background 0.15s;
  }
  nav a:hover,
  nav a[aria-current='page'] {
    background: rgb(255 255 255 / 0.12);
    color: #fff;
  }
  @media (max-width: 600px) {
    .logo span {
      display: none;
    }
    nav a {
      padding: 8px 9px;
      font-size: 0.92rem;
    }
  }
  .site-footer {
    background: var(--deep);
    color: var(--on-dark);
    padding: 40px 0 28px;
  }
  .site-footer a {
    color: #fff;
    text-decoration: none;
    display: block;
    padding: 4px 0;
    opacity: 0.85;
  }
  .site-footer a:hover {
    opacity: 1;
    color: var(--lagoon-soft);
  }
  .site-footer .muted {
    color: var(--on-dark-muted);
  }
  .cols {
    display: grid;
    gap: 36px;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
  }
  .logo-foot {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-size: 1.6rem;
    margin: 0 0 8px;
  }
  h4 {
    margin: 0 0 10px;
    font-size: 0.78rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--lagoon);
  }
  .fine {
    margin-top: 40px;
    padding-top: 20px;
    border-top: 1px solid rgb(255 255 255 / 0.08);
    font-size: 0.85rem;
  }
</style>
