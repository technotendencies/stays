---
import type { Stay } from '../data/types';
import OceanArt from './OceanArt.astro';
import { stayPhoto } from '../lib/photos';

interface Props {
  stay: Stay;
  eager?: boolean;
  sizes?: string;
}
const { stay, eager = false } = Astro.props;
const src = stayPhoto(stay.slug, stay.image);
// Keep placeholder water in ocean hues so every card still reads as "beach".
const hue = 170 + (stay.hue % 45);
const dusk = stay.categories.includes('luxury') || stay.type === 'boutique';
---

{
  src ? (
    <img src={src} alt={`${stay.name}, Hiriketiya`} loading={eager ? 'eager' : 'lazy'} decoding="async" width="1200" height="800" />
  ) : (
    <OceanArt hue={hue} time={dusk ? 'dusk' : 'day'} label={`${stay.name} (photo coming soon)`} />
  )
}

<style>
  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
