---
import OceanArt from './OceanArt.astro';
import Icon from './Icon.astro';
import { guidePhoto, photoCredit } from '../lib/photos';

interface Props {
  id: string;
  title: string;
  description: string;
  order: number;
}
const { id, title, description, order } = Astro.props;
const img = guidePhoto(id);
---

<a class="guide" href={`/guides/${id}/`}>
  <div class="media">
    {img ? <img src={img} alt={photoCredit(img)?.alt ?? ""} loading="lazy" /> : <OceanArt hue={172 + order * 5} time={order % 3 === 0 ? 'dusk' : 'day'} palms={order % 2 === 1} />}
  </div>
  <div class="text">
    <span class="title">{title}</span>
    <span class="desc">{description}</span>
    <span class="link-arrow">Read guide <Icon name="arrowRight" size={16} /></span>
  </div>
</a>

<style>
  .guide {
    display: flex;
    flex-direction: column;
    background: var(--card);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
    text-decoration: none;
    color: var(--ink);
    transition:
      transform 0.2s,
      box-shadow 0.2s;
  }
  .guide:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }
  .media {
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }
  .media :global(img),
  .media :global(svg) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .text {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px 22px 24px;
    flex: 1;
  }
  .title {
    font-family: var(--font-display);
    font-size: 1.45rem;
    line-height: 1.15;
  }
  .desc {
    color: var(--muted);
    font-size: 0.95rem;
    flex: 1;
  }
  .link-arrow {
    color: var(--ocean-700);
    margin-top: 6px;
  }
</style>
