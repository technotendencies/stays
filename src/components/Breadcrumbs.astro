---
interface Props {
  items: { name: string; href: string }[];
}
const { items } = Astro.props;
---

<nav class="crumbs" aria-label="Breadcrumb">
  <a href="/">Home</a>
  {
    items.map((c, i) => (
      <>
        <span aria-hidden="true">/</span>
        {i === items.length - 1 ? <span aria-current="page">{c.name}</span> : <a href={c.href}>{c.name}</a>}
      </>
    ))
  }
</nav>

<style>
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    font-size: 0.88rem;
    color: var(--muted);
    padding: 20px 0 8px;
  }
  .crumbs a {
    color: var(--muted);
  }
</style>
