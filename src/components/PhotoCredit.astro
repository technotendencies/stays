---
import { photoCredit } from '../lib/photos';

interface Props {
  src?: string;
  /** Prefix such as "Illustrative photo" for demo listings. */
  note?: string;
  /** Distance from the bottom of the photo, to clear wave edges. */
  bottom?: number;
}
const { src, note, bottom = 10 } = Astro.props;
const c = photoCredit(src);
---

{
  c && (
    <p class="photo-credit" style={`bottom:${bottom}px`}>
      {note && <span>{note}: </span>}
      <a href={c.sourceUrl} rel="noopener nofollow" target="_blank">
        {c.alt}
      </a>{' '}
      by {c.creator}, <a href={c.licenseUrl} rel="noopener license" target="_blank">{c.license}</a>
    </p>
  )
}

<style>
  .photo-credit {
    position: absolute;
    right: 12px;
    bottom: 10px;
    z-index: 2;
    max-width: min(90%, 520px);
    margin: 0;
    padding: 3px 10px;
    border-radius: 999px;
    background: rgb(3 24 42 / 0.55);
    backdrop-filter: blur(6px);
    color: rgb(255 255 255 / 0.85);
    font-size: 0.72rem;
    line-height: 1.5;
    text-align: right;
  }
  .photo-credit a {
    color: inherit;
  }
</style>
