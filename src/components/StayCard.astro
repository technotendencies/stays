---
import type { Stay } from '../data/types';
import StayImage from './StayImage.astro';
import Icon from './Icon.astro';
import { beachDistance, formatDistance, isDemo, priceSymbols, typeLabels } from '../lib/stays';

interface Props {
  stay: Stay;
  rank?: number;
  showMonthly?: boolean;
}
const { stay, rank, showMonthly = false } = Astro.props;
const d = beachDistance(stay);
const href = `/stays/${stay.slug}/`;
---

<article class="card" data-sleeps={stay.type === 'hostel' || !stay.sleeps ? 99 : stay.sleeps} data-categories={stay.categories.join(' ')} data-price={stay.priceFrom ?? ''}>
  <a href={href} class="media" tabindex="-1" aria-hidden="true">
    <StayImage stay={stay} />
    {rank && <span class="rank">{String(rank).padStart(2, '0')}</span>}
    <span class="best">{stay.bestFor[0]}</span>
    {stay.rating && (
      <span class="rating">
        <Icon name="star" size={14} /> {stay.rating.toFixed(1)}
      </span>
    )}
  </a>
  <div class="body">
    <h3><a href={href}>{stay.name}</a></h3>
    <p class="loc">
      <Icon name="mapPin" size={15} />
      <span>{stay.area} · {formatDistance(d.meters)}</span>
    </p>
    <p class="summary">{stay.summary}</p>
    <div class="foot">
      <span class="price">
        {showMonthly && stay.monthlyFrom ? (
          <span>
            <b>${stay.monthlyFrom.toLocaleString('en-US')}</b> / month
          </span>
        ) : stay.priceFrom ? (
            <span>
              from <b>${stay.priceFrom}</b> / night
            </span>
        ) : (
          <span>
            <b>See prices</b>
          </span>
        )}
        <span class="type">
          {typeLabels[stay.type]}
          {stay.priceFrom && <> · {priceSymbols(stay.priceFrom)}</>}
        </span>
      </span>
      <a class="link-arrow" href={href}>
        View stay <Icon name="arrowRight" size={16} />
      </a>
    </div>
    {isDemo(stay) && <span class="badge demo" title="Demo listing: an invented example, not a real property">Demo listing</span>}
  </div>
</article>

<style>
  .card {
    --c-bg: var(--card);
    --c-ink: var(--ink);
    --c-muted: var(--muted);
    --c-line: var(--line);
    --c-accent: var(--ocean-500);
    background: var(--c-bg);
    color: var(--c-ink);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
    display: flex;
    flex-direction: column;
    transition:
      transform 0.2s,
      box-shadow 0.2s;
  }
  .card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }
  :global(.dark) .card {
    --c-bg: linear-gradient(180deg, #0c3d60 0%, #08304d 100%);
    --c-ink: #f1f8fa;
    --c-muted: #a9c6d3;
    --c-line: rgb(255 255 255 / 0.12);
    --c-accent: var(--lagoon);
    border: 1px solid rgb(69 201 198 / 0.22);
    box-shadow: 0 20px 50px rgb(0 0 0 / 0.3);
  }
  .media {
    position: relative;
    aspect-ratio: 3 / 2;
    display: block;
    overflow: hidden;
  }
  .media :global(img),
  .media :global(svg) {
    transition: transform 0.5s ease;
  }
  .card:hover .media :global(img),
  .card:hover .media :global(.ocean-art) {
    transform: scale(1.04);
  }
  .rank {
    position: absolute;
    top: 14px;
    left: 14px;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: rgb(3 24 42 / 0.82);
    border: 2px solid rgb(255 255 255 / 0.25);
    color: #fff;
    font-weight: 700;
    font-size: 0.95rem;
  }
  .best,
  .rating {
    position: absolute;
    top: 14px;
    right: 14px;
    background: rgb(255 255 255 / 0.9);
    backdrop-filter: blur(6px);
    color: var(--ink);
    font-size: 0.8rem;
    font-weight: 600;
    padding: 6px 12px;
    border-radius: 999px;
  }
  .rating {
    top: auto;
    bottom: 14px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .rating :global(svg) {
    color: #f2a33a;
    fill: #f2a33a;
  }
  .body {
    padding: 22px 24px 22px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
  }
  h3 {
    margin: 0;
    font-size: 1.55rem;
  }
  h3 a,
  :global(.dark) .card h3 a {
    color: var(--c-ink);
    text-decoration: none;
  }
  .loc {
    display: flex;
    align-items: center;
    gap: 7px;
    margin: 0;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-muted);
  }
  .loc :global(svg) {
    color: var(--c-accent);
    flex: none;
  }
  .summary {
    margin: 0;
    color: var(--c-muted);
    font-size: 1rem;
  }
  .foot {
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px solid var(--c-line);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }
  .price {
    display: grid;
    font-size: 0.88rem;
    color: var(--c-muted);
    line-height: 1.3;
  }
  .price b {
    color: var(--c-ink);
    font-size: 1.25rem;
  }
  .type {
    font-size: 0.8rem;
  }
  .foot .link-arrow,
  :global(.dark) .card .foot .link-arrow {
    color: var(--c-ink);
  }
  .badge {
    align-self: flex-start;
  }
</style>
